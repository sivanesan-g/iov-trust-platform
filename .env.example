APP_ENV=development
PORT=5000

DATABASE_URL=postgresql://iov:iov_password@postgres:5432/iov

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TOPIC=iov/+/telemetry

# Sepolia testnet. Keep secrets only in the hosting provider's environment settings.
ETH_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/REPLACE_WITH_PROVIDER_KEY
ETH_CHAIN_ID=11155111
ETH_ACCOUNT=0xREPLACE_WITH_TESTNET_ACCOUNT
ETH_PRIVATE_KEY=REPLACE_WITH_TESTNET_PRIVATE_KEY
ETH_CONTRACT_ADDRESS=

MODEL_PATH=models/classifier.pkl
SCALER_PATH=models/state_scaler.pkl

MODEL_VERSION=1.0.0
SCALER_VERSION=1.0.0

JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256

MAX_MESSAGE_AGE_SECONDS=30
MAX_FUTURE_SKEW_SECONDS=10
MAX_MESSAGES_PER_SECOND=20

SHARD_COUNT=4

TRUST_CRITICAL=0.20
TRUST_VERY_LOW=0.40
TRUST_LOW=0.60
TRUST_MEDIUM=0.80

TRUST_REWARD_NORMAL=0.02
TRUST_PENALTY_ATTACK=0.15
TRUST_PENALTY_REPLAY=0.25
TRUST_PENALTY_INVALID=0.10

VALIDATOR_MIN_TRUST=0.80
